# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (sb_publishable_...) from Dashboard -> Settings -> API Keys
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
# Secret key (sb_secret_...) — server only, bypasses RLS
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx

# --- Demo admin (one-click login) ----------------------------------------
DEMO_ADMIN_EMAIL=admin@raketship.ph
DEMO_ADMIN_PASSWORD=change-me
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=true

# --- App ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
